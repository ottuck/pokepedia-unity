# 줄바꿈은 저장소에 LF 로 저장한다 (Windows 작업 사본은 git 설정에 따름)
* text=auto
*.cs text diff=csharp
*.sh text eol=lf

# 바이너리
*.png binary
*.gif binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.unitypackage binary

# Cloudflare Pages 헤더 규칙: 헤더 값에  이 섞이지 않게 항상 LF
Tools/web/_headers text eol=lf

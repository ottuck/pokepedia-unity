<Project Sdk="Microsoft.NET.Sdk">

  <!--
    속성 기반 합성기(Assets/Scripts/Presentation/Audio/Synth)를 Unity 없이 WAV 로 렌더하는 콘솔 도구.
    합성기 소스는 복사하지 않고 링크만 한다. UnityEngine 참조가 없으므로 링크된 파일이 UnityEngine 을 쓰면 빌드가 깨진다.
    실행 명령은 Program.cs 머리 주석 참고.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <!-- Unity 6 의 C# 수준에 맞춘다. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>Pokepedia.Tools.AudioRender</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\Assets\Scripts\Presentation\Audio\Synth\**\*.cs" Link="Synth\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
